# Home Assistant package: @@person@@ recliner reminders
# Generated by generate.py. Save as config/packages/@@pid@@_recliner.yaml
#
# Requires:
#   - The ESPHome device "@@chair_name@@", which provides
#     binary_sensor.@@chair_id@@_occupied and binary_sensor.@@chair_id@@_pad_cable
#   - Packages enabled in configuration.yaml:
#       homeassistant:
#         packages: !include_dir_named packages
#
# Notifications go to @@notify@@. To alert several phones, create a
# notify group (see docs/testing.md) and regenerate with the group's action.

# ---------------------------------------------------------------------------
# Helpers (adjustable from the HA UI)
# ---------------------------------------------------------------------------
input_boolean:
  @@pid@@_reminders_enabled:
    name: @@person@@ reminders enabled
    icon: mdi:bell-ring

  @@pid@@_got_up_alerts_enabled:
    name: @@person@@ got up alerts enabled
    icon: mdi:human-cane

  @@pid@@_long_sit_alert_enabled:
    name: @@person@@ @@long_sit_hours@@ hour seated alert enabled
    icon: mdi:timer-alert

input_number:
  @@pid@@_reminder_minutes:
    name: @@person@@ reminder interval
    min: 1
    max: 360
    step: 1
    mode: box
    unit_of_measurement: min
    icon: mdi:timer-sand

  @@pid@@_escalation_minutes:
    name: @@person@@ escalation delay
    min: 1
    max: 60
    step: 1
    mode: box
    unit_of_measurement: min
    icon: mdi:alarm-light

input_datetime:
  @@pid@@_last_checked:
    name: @@person@@ last checked
    has_date: true
    has_time: true

  @@pid@@_snooze_until:
    name: @@person@@ reminder snoozed until
    has_date: true
    has_time: true

@@webhook_rest_command@@
# ---------------------------------------------------------------------------
# Template sensors
# ---------------------------------------------------------------------------
template:
  # Sat Down and Last Got Up alternate: each records now only when the other
  # is newer (the person was last recorded in the opposite state). So a real
  # change records immediately, while HA restarts, device reconnects and pad
  # cable faults never reset them. A stand-up missed during an outage is
  # recorded when the sensor returns.

  # Last stood up. Ignored while the pad cable is broken, because a broken pad
  # reads as an empty chair.
  - triggers:
      - trigger: state
        entity_id: binary_sensor.@@chair_id@@_occupied
        to: "off"
    sensor:
      - name: @@person@@ Last Got Up
        unique_id: @@pid@@_last_got_up
        device_class: timestamp
        state: >
          {% set prev = as_timestamp(this.state, none) %}
          {% set sat = as_timestamp(states('sensor.@@pid@@_sat_down'), 0) %}
          {% if is_state('binary_sensor.@@chair_id@@_pad_cable', 'on') %}
            {{ this.state }}
          {% elif prev is none or sat > prev %}
            {{ now().isoformat() }}
          {% else %}
            {{ this.state }}
          {% endif %}

  # Last sat down. After a cable fault is repaired while still seated, keeps
  # the original sit-down time.
  - triggers:
      - trigger: state
        entity_id: binary_sensor.@@chair_id@@_occupied
        to: "on"
    sensor:
      - name: @@person@@ Sat Down
        unique_id: @@pid@@_sat_down
        device_class: timestamp
        state: >
          {% set prev = as_timestamp(this.state, none) %}
          {% set up = as_timestamp(states('sensor.@@pid@@_last_got_up'), 0) %}
          {% if prev is none or up > prev %}
            {{ now().isoformat() }}
          {% else %}
            {{ this.state }}
          {% endif %}

  - binary_sensor:
      # Seated, carried through sensor faults: while the device is unavailable
      # or unknown, or the pad cable is broken, keep the last known state
      # instead of dropping to off, so a WiFi blip, reboot or damaged pad never
      # cancels a reminder.
      - name: @@person@@ Seated
        unique_id: @@pid@@_seated
        device_class: occupancy
        state: >
          {% set occ = states('binary_sensor.@@chair_id@@_occupied') %}
          {% if occ in ['on', 'off'] and not is_state('binary_sensor.@@chair_id@@_pad_cable', 'on') %}
            {{ occ == 'on' }}
          {% else %}
            {{ as_timestamp(states('sensor.@@pid@@_sat_down'), 0)
               > as_timestamp(states('sensor.@@pid@@_last_got_up'), 0) }}
          {% endif %}

      # On when seated longer than the interval since sitting down or since the
      # last check was marked handled, no snooze is active, and it is between
      # @@window_start@@ and @@window_end@@ (no reminders overnight). At @@window_end@@ an active
      # reminder stops and clears; at @@window_start@@ it starts again right away if
      # still seated and overdue.
      - name: @@person@@ Check Due
        unique_id: @@pid@@_check_due
        icon: mdi:human-cane
        state: >
          {% set now_ts = now().timestamp() %}
          {% set sat = as_timestamp(states('sensor.@@pid@@_sat_down'), 0) %}
          {% set checked = state_attr('input_datetime.@@pid@@_last_checked', 'timestamp') or 0 %}
          {% set snooze = state_attr('input_datetime.@@pid@@_snooze_until', 'timestamp') or 0 %}
          {% set interval = states('input_number.@@pid@@_reminder_minutes') | float(120) * 60 %}
          {{ is_state('binary_sensor.@@pid@@_seated', 'on')
             and is_state('input_boolean.@@pid@@_reminders_enabled', 'on')
             and (now_ts - [sat, checked] | max) > interval
             and now_ts > snooze
             and today_at('@@window_start@@') <= now() < today_at('@@window_end@@') }}

  - sensor:
      - name: @@person@@ Minutes Seated
        unique_id: @@pid@@_minutes_seated
        unit_of_measurement: min
        state_class: measurement
        state: >
          {% if is_state('binary_sensor.@@pid@@_seated', 'on') %}
            {{ ((now().timestamp() - as_timestamp(states('sensor.@@pid@@_sat_down'), now().timestamp())) / 60) | round(0) | int }}
          {% else %}
            0
          {% endif %}

# ---------------------------------------------------------------------------
# Escalation script: critical phone alert plus an event (and optional webhook)
# that another system, such as an assistant or pager, can act on
# ---------------------------------------------------------------------------
script:
  @@pid@@_escalate:
    alias: @@person@@ check escalation
    mode: queued
    sequence:
      # Louder phone alert. iOS uses the push block, Android uses the rest;
      # each platform ignores the other's keys.
      - action: @@notify@@
        data:
          title: "@@person@@ check overdue"
          message: >
            Seated {{ states('sensor.@@pid@@_minutes_seated') }} min and not acknowledged.
          data:
            tag: @@pid@@_check
            ttl: 0
            priority: high
            channel: @@pid@@_urgent
            importance: high
            push:
              sound:
                name: default
                critical: 1
                volume: 1.0
            actions:
              - action: @@PID@@_HANDLED
                title: Handled
              - action: @@PID@@_SNOOZE
                title: Snooze @@snooze_minutes@@ min

      # Listen for this event in another automation or integration to escalate
      # further. event_data.person identifies whose chair it is.
      - event: recliner_escalation
        event_data:
          person: @@pid@@
          priority: high
          message: >
            @@person@@ has been in the chair for
            {{ states('sensor.@@pid@@_minutes_seated') }} minutes and the
            reminder has not been acknowledged. Please get @@caregiver@@'s attention.
@@webhook_escalate_step@@
# ---------------------------------------------------------------------------
# Automations
# ---------------------------------------------------------------------------
automation:
  # Main loop: remind, escalate if ignored, repeat until handled or they get up
  - id: @@pid@@_check_reminder
    alias: @@person@@ check reminder
    mode: single
    triggers:
      - trigger: state
        entity_id: binary_sensor.@@pid@@_check_due
        to: "on"
    actions:
      - repeat:
          while:
            - condition: state
              entity_id: binary_sensor.@@pid@@_check_due
              state: "on"
          sequence:
            - action: @@notify@@
              data:
                title: "Time to check on @@person@@"
                message: >
                  @@person@@ has been in the chair for
                  {{ states('sensor.@@pid@@_minutes_seated') }} minutes.
                data:
                  tag: @@pid@@_check
                  priority: high
                  push:
                    interruption-level: time-sensitive
                  actions:
                    - action: @@PID@@_HANDLED
                      title: Handled
                    - action: @@PID@@_SNOOZE
                      title: Snooze @@snooze_minutes@@ min

            - wait_for_trigger:
                - trigger: state
                  entity_id: binary_sensor.@@pid@@_check_due
                  to: "off"
              timeout: "{{ states('input_number.@@pid@@_escalation_minutes') | int(10) * 60 }}"

            - if:
                - condition: state
                  entity_id: binary_sensor.@@pid@@_check_due
                  state: "on"
              then:
                - action: script.@@pid@@_escalate
                - wait_for_trigger:
                    - trigger: state
                      entity_id: binary_sensor.@@pid@@_check_due
                      to: "off"
                  timeout: "{{ states('input_number.@@pid@@_escalation_minutes') | int(10) * 60 }}"

      # Resolved: clear the phone notification and signal stand-down
      - action: @@notify@@
        data:
          message: clear_notification
          data:
            tag: @@pid@@_check
      - event: recliner_escalation_resolved
        event_data:
          person: @@pid@@
@@webhook_resolved_step@@

  # Notification buttons
  - id: @@pid@@_check_actions
    alias: @@person@@ check notification actions
    mode: queued
    triggers:
      - trigger: event
        event_type: mobile_app_notification_action
        event_data:
          action: @@PID@@_HANDLED
        id: handled
      - trigger: event
        event_type: mobile_app_notification_action
        event_data:
          action: @@PID@@_SNOOZE
        id: snooze
    actions:
      - choose:
          - conditions:
              - condition: trigger
                id: handled
            sequence:
              - action: input_datetime.set_datetime
                target:
                  entity_id: input_datetime.@@pid@@_last_checked
                data:
                  timestamp: "{{ now().timestamp() }}"
          - conditions:
              - condition: trigger
                id: snooze
            sequence:
              - action: input_datetime.set_datetime
                target:
                  entity_id: input_datetime.@@pid@@_snooze_until
                data:
                  timestamp: "{{ now().timestamp() + @@snooze_seconds@@ }}"

  # Sensor offline alert
  - id: @@pid@@_recliner_sensor_offline
    alias: @@person@@ recliner sensor offline
    mode: single
    triggers:
      - trigger: state
        entity_id: binary_sensor.@@chair_id@@_occupied
        to: "unavailable"
        for: "00:03:00"
    conditions:
      - condition: state
        entity_id: input_boolean.@@pid@@_reminders_enabled
        state: "on"
    actions:
      - action: @@notify@@
        data:
          title: "@@chair_name@@ sensor offline"
          message: "Check power and WiFi. Reminders continue from the last known state until it reconnects."
          data:
            priority: high
            push:
              interruption-level: time-sensitive

  # Pad cable cut or pad unplugged. The device is online but can no longer
  # tell whether anyone is in the chair.
  - id: @@pid@@_recliner_pad_fault
    alias: @@person@@ recliner pad disconnected
    mode: single
    triggers:
      - trigger: state
        entity_id: binary_sensor.@@chair_id@@_pad_cable
        to: "on"
        for: "00:00:10"
    conditions:
      - condition: state
        entity_id: input_boolean.@@pid@@_reminders_enabled
        state: "on"
    actions:
      - action: @@notify@@
        data:
          title: "@@chair_name@@ pad disconnected"
          message: >
            The pad cable is cut or unplugged, so the sensor can't tell whether
            @@person@@ is in the chair. Reminders continue from the last known state.
          data:
            priority: high
            push:
              interruption-level: time-sensitive

  # Alert when they get up. Uses the filtered sensor, so it arrives about
  # @@delayed_off@@ s after standing (the firmware's delayed_off), and a sensor outage
  # never looks like a stand-up.
  - id: @@pid@@_got_up_alert
    alias: @@person@@ got up alert
    mode: single
    triggers:
      - trigger: state
        entity_id: binary_sensor.@@chair_id@@_occupied
        from: "on"
        to: "off"
    conditions:
      - condition: state
        entity_id: input_boolean.@@pid@@_got_up_alerts_enabled
        state: "on"
      # A broken pad reads as an empty chair; don't report that as getting up
      - condition: not
        conditions:
          - condition: state
            entity_id: binary_sensor.@@chair_id@@_pad_cable
            state: "on"
    actions:
      - action: @@notify@@
        data:
          title: "@@person@@ is up"
          message: >
            @@person@@ got up after
            {{ ((now().timestamp() - as_timestamp(states('sensor.@@pid@@_sat_down'), now().timestamp())) / 60) | round(0) | int }}
            minutes in the chair.
          data:
            tag: @@pid@@_got_up
            priority: high
            push:
              interruption-level: time-sensitive

  # Seated @@long_sit_hours@@ hours without getting up, @@window_start@@ to @@window_end@@ only.
  # The @@window_start@@ trigger catches a long sit that crossed the threshold overnight.
  - id: @@pid@@_long_sit_alert
    alias: @@person@@ seated @@long_sit_hours@@ hours (daytime)
    mode: single
    triggers:
      - trigger: numeric_state
        entity_id: sensor.@@pid@@_minutes_seated
        above: @@long_sit_threshold@@
      - trigger: time
        at: "@@window_start@@:00"
    conditions:
      - condition: state
        entity_id: input_boolean.@@pid@@_long_sit_alert_enabled
        state: "on"
      - condition: time
        after: "@@window_start@@:00"
        before: "@@window_end@@:00"
      - condition: numeric_state
        entity_id: sensor.@@pid@@_minutes_seated
        above: @@long_sit_threshold@@
    actions:
      - action: @@notify@@
        data:
          title: "@@person@@ hasn't been up in @@long_sit_hours@@ hours"
          message: >
            @@person@@ has been in the chair for
            {{ states('sensor.@@pid@@_minutes_seated') }} minutes.
          data:
            tag: @@pid@@_long_sit
            priority: high
            push:
              interruption-level: time-sensitive
