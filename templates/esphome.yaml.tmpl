# ESPHome config: @@chair_name@@ occupancy sensor
# Generated by generate.py. Re-run the generator rather than editing names here,
# because the Home Assistant package depends on the entity IDs they produce.
#
# Board: Seeed Studio XIAO ESP32S3 with its FPC antenna attached.
#
# Pad wiring (see docs/wiring.md). The pad is two loops, and the switch is
# between them:
#   switch wire  -> 1k resistor -> D3 (GPIO4)   pulled LOW when someone sits
#   return wire  -> GND                         other loop, one end
#   check wire   -> D4 (GPIO5)                  other loop, other end: LOW
#                                               while the cable is intact
#   fourth wire  -> unused, insulated
#
# Home Assistant entity IDs:
#   binary_sensor.@@chair_id@@_occupied    filtered occupancy
#   binary_sensor.@@chair_id@@_pad_raw     unfiltered pad contact (diagnostic)
#   binary_sensor.@@chair_id@@_pad_cable   problem when the pad is disconnected

esphome:
  name: @@device_name@@
  friendly_name: @@chair_name@@

esp32:
  variant: esp32s3
  flash_size: 8MB

logger:

api:
  encryption:
    key: !secret @@secret_prefix@@_api_key

ota:
  - platform: esphome
    encryption:   # empty: reuses the API encryption key

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  power_save_mode: none   # wall powered; favor responsiveness
  ap:
    ssid: @@chair_name@@ Fallback
    password: !secret @@secret_prefix@@_fallback_password

captive_portal:

binary_sensor:
  # Direct pad reading. Kept as a diagnostic entity so you can watch bounce and
  # confirm the pad sits where the person actually lands.
  - platform: gpio
    id: pad_raw
    name: Pad Raw
    entity_category: diagnostic
    pin:
      number: GPIO4        # D3
      mode:
        input: true
        pullup: true
      inverted: true
    filters:
      - delayed_on_off: 50ms   # contact bounce only
    on_state:
      - logger.log:
          format: "Pad raw: %s"
          args: ['x ? "closed" : "open"']

  # Cable break detection. The check wire and the return wire are two ends of
  # one conductor, so D4 reads LOW through the loop to GND while the pad is
  # connected. A cut cable or unplugged pad lets the pull-up win: HIGH means a
  # problem. Without this, a broken pad reads as an empty chair and silently
  # stops reminders.
  - platform: gpio
    id: pad_cable
    name: Pad Cable
    device_class: problem
    entity_category: diagnostic
    pin:
      number: GPIO5        # D4
      mode:
        input: true
        pullup: true
    filters:
      - delayed_on_off: 2s   # ignore a momentary glitch
    on_state:
      - logger.log:
          format: "Pad cable: %s"
          args: ['x ? "BROKEN" : "ok"']

  # What Home Assistant uses for occupancy.
  - platform: template
    name: Occupied
    device_class: occupancy
    lambda: return id(pad_raw).state;
    filters:
      - delayed_on: @@delayed_on@@s    # ignore brief contact
      - delayed_off: @@delayed_off@@s   # ignore shifting, leaning forward, landing bounce

sensor:
  - platform: wifi_signal
    name: WiFi Signal
    update_interval: 60s
  - platform: uptime
    name: Uptime

button:
  - platform: restart
    name: Restart
